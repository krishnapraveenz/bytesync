{
  "name": "bytesync-website",
  "version": "1.0.0",
  "description": "Bytesync Technologies official website - SEO optimized",
  "scripts": {
    "dev": "live-server --port=3000",
    "build": "echo 'Build skipped for static deployment' && exit 0",
    "minify-js": "terser script.js -o script.min.js",
    "optimize-images": "imagemin *.png --out-dir=optimized/ --plugin.webp",
    "validate-sitemap": "xmllint --noout sitemap.xml"
  },
  "devDependencies": {
    "cssnano": "^6.0.1",
    "terser": "^5.26.0",
    "imagemin": "^8.0.1",
    "imagemin-webp": "^7.0.0",
    "live-server": "^1.2.2"
  }
}
